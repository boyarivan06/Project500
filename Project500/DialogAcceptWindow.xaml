<Window x:Class="Project500.DialogAcceptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project500"
        mc:Ignorable="d" ResizeMode="NoResize" BorderBrush="Red" BorderThickness="5"
        Title="Важное предупреждение" Height="210" Width="310" Background="#FFAAAAAA" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="37*"/>
            <RowDefinition Height="21*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Мы представляем девятиклассниками уникальную возможность &#xD;&#xA;готовиться к государственным экзаменам. &#xD;&#xA;В связи с этим мы предупреждаем вас, что все&#xD;&#xA;введённые данные могут использоваться нами в &#xD;&#xA;любых целях." Grid.ColumnSpan="3" Grid.RowSpan="2"/>
        <Button x:Name="Acceptbutton" Content="Принять" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Height="32" Margin="0,111,0,0" Width="63" Background="#FF52B60A" Grid.RowSpan="2" Click="Acceptbutton_Click"/>
        <Button x:Name="Unacceptbutton" Content="Не принимать" FontSize="10" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Height="32" Margin="83,111,0,0" Width="73" Background="#FFB60A0A" Grid.RowSpan="2" Grid.ColumnSpan="2" Click="Unacceptbutton_Click"/>
    </Grid>
</Window>
