<UserControl x:Class="Project500._13_2_QuestionInterface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Project500"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="47*"/>
            <ColumnDefinition Width="53*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4*"/>
            <RowDefinition/>
            <!--<RowDefinition Height="Auto"/>-->
        </Grid.RowDefinitions>

        <Label x:Name="task_name" Content="Question name" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Width="180" Height="25" Grid.ColumnSpan="2" Margin="10,0,0,0"/>
        <Image x:Name="task_image" Source="img/hgh.png" Grid.Row="1" Grid.RowSpan="1" Grid.Column="1"/>
           <Label x:Name="task_text" Content="task text" FontSize="8" HorizontalAlignment="Left" VerticalAlignment="Center" Height="66" Width="84" Grid.Row="1" Margin="10,0,0,0"/>
        <Button x:Name="doc_source_button" Grid.Row="2" Content="Выбрать файл" Click="doc_source_button_Click" Grid.ColumnSpan="2"/>
        <!--<TextBox x:Name="answer_input" HorizontalAlignment="Center" Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Center" Width="200"/>-->
    </Grid>
</UserControl>
