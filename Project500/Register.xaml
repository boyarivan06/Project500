<Window x:Class="Project500.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project500"
        mc:Ignorable="d" ResizeMode="NoResize"
        Title="Регистрация" Height="225" Width="400">
    <Grid>
        <Label Content="Зарегистрируйтесь или войдите в систему&#xD;&#xA;" HorizontalAlignment="Left" Margin="41,10,0,0" VerticalAlignment="Top" Height="45" Width="335" FontSize="15"/>
        <Label Content="Имя пользователя:" HorizontalAlignment="Left" Margin="97,55,0,0" VerticalAlignment="Top" Height="29"/>
        <TextBox x:Name="name_box" HorizontalAlignment="Left" Margin="225,60,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Пароль:" HorizontalAlignment="Left" Margin="157,88,0,0" VerticalAlignment="Top" Height="29"/>
        <PasswordBox x:Name="password_box" HorizontalAlignment="Left" Margin="225,94,0,0" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="enter_button" Content="Войти" Click="Button_Click" HorizontalAlignment="Left" Margin="272,140,0,0" VerticalAlignment="Top" Height="34" Width="104" Background="#FF31CF00"/>
        <Label x:Name="warning_label" Content="" HorizontalAlignment="Left" Margin="10,148,0,0" VerticalAlignment="Top" Width="139" Foreground="Red"/>
        <Button x:Name="return_button" Click="return_button_Click" Content="Отмена" HorizontalAlignment="Left" Margin="172,142,0,0" VerticalAlignment="Top" Height="32" Width="74" Background="Red"/>
        

    </Grid>
</Window>
